{
  "name": "mainsite",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "release": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release && git push --follow-tags",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --major && git push --follow-tags",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --minor && git push --follow-tags",
    "release:patch": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --patch && git push --follow-tags",
    "playwright:install": "playwright install --with-deps",
    "cleanup": "nuxt cleanup && rm -rf .nuxt .output dist node_modules/.cache",
    "lint": "oxlint lint .",
    "lint:eslint": "eslint . --ext .ts,.vue",
    "fix": "oxlint fix .",
    "production": "pnpm run lint && pnpm run test:unit && pnpm run build"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.10",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.16",
    "firebase": "^12.19.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@pinia/nuxt": "1.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/vue": "^8.1.0",
    "@unlok-co/nuxt-stripe": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/math": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "happy-dom": "^20.14.5",
    "lucide-vue-next": "^1.0.0",
    "nuxt-authentication": "^2.3.0",
    "nuxt-vuefire": "1.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "primevue": "^5.0.2",
    "sass-embedded": "^1.105.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vue-stripe-js": "^2.0.2",
    "zod": "^4.6.5"
  }
}
